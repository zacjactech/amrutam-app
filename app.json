{
  "expo": {
    "name": "Amrutam",
    "slug": "amrutam-app",
    "scheme": "amrutam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amrutam.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#145C3A"
      },
      "package": "com.amrutam.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image",
        {
          "photosPermission": "The app accesses your photos to let you share them."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "4d907dd2-959b-41b6-83cf-b0c5aecc5d04"
      }
    },
    "updates": {},
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "zacjactech"
  }
}
